# Variables locales de test backend.
# Copier ce fichier vers `.env.test.local` et adapter si nécessaire.

# URL d'administration PostgreSQL.
# Elle doit pointer vers une base existante qui a le droit de créer/supprimer
# des bases temporaires, typiquement `postgres`.
DATABASE_URL_TEST=postgresql://pinball_user:change_me@localhost:5432/postgres

# Variables minimales nécessaires pour construire l'application pendant les tests.
DATABASE_URL=postgresql://pinball_user:change_me@localhost:5432/pinball_db
BETTER_AUTH_SECRET=change_me_for_local_backend_tests_only
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173
